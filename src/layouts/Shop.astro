---
import '../styles/brand.css';
import '../styles/shop.css';
import FarmaHouseLogo from '../components/FarmaHouseLogo.astro';
import Icon from '../components/shop/Icon.astro';
import MegaMenu from '../components/shop/MegaMenu.astro';
import '../styles/store-discovery.css';
interface Props {title: string; description?: string;}
const {title, description = 'Tu espacio de cuidado diario. Descubre la experiencia de parafarmacia omnicanal de FarmaHouse Demo.'} = Astro.props;
---
<!doctype html>
<html lang="es">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#84ba47"/><title>{title} · FarmaHouse Demo</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/fonts/fraunces-latin-var.woff2" as="font" type="font/woff2" crossorigin/></head>
<body data-store-collection="farmahouse">
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<div class="demo-bar"><span><span class="status-dot"></span> Catálogo FarmaHouse · Compra de demostración, sin cobros.</span><a href="/admin">Explorar el panel omnicanal <span aria-hidden="true">↗</span></a></div>
<header class="shop-header">
  <div class="header-main wrap"><a class="brand" href="/" aria-label="FarmaHouse Demo, inicio"><FarmaHouseLogo /><small>TIENDA DE DEMOSTRACIÓN</small></a>
  <form class="header-search" action="/tienda" role="search"><Icon name="search" size={20}/><label class="sr-only" for="header-search">Buscar productos</label><input id="header-search" name="q" type="search" placeholder="¿Qué necesitas para cuidarte?" value={Astro.url.searchParams.get('q') ?? ''}/><button type="submit" aria-label="Buscar"><Icon name="arrow" size={20}/></button></form>
  <div class="header-actions"><a class="account-link" href="/cuenta" aria-label="Mi cuenta"><Icon name="face" size={18}/><span>Mi cuenta</span></a><a class="admin-link" href="/admin" aria-label="Explorar el panel omnicanal"><Icon name="grid" size={18}/><span>Panel omnicanal</span></a><a class="cart-link" href="/carrito" aria-label="Ver mi carrito"><Icon name="bag" size={23}/><span class="cart-label">Mi cesta</span><span id="cart-count" class="cart-count">0</span></a></div>
  </div>
  <MegaMenu />
</header>
<main id="contenido"><slot/></main>
<footer class="shop-footer"><div class="wrap footer-top"><div><a class="brand footer-brand" href="/"><FarmaHouseLogo light /></a><p>Pequeños gestos.<br/>Una forma mejor de cuidarte.</p></div><div><h2>Encuentra tu cuidado</h2><a href="/tienda?categoria=facial">Cuidado facial</a><a href="/tienda?categoria=capilar">Cuidado capilar</a><a href="/tienda?categoria=bebe">Bebé y mamá</a><a href="/tienda?categoria=solares">Protección solar</a></div><div><h2>Tu experiencia demo</h2><a href="/tienda">Explorar la tienda</a><a href="/carrito">Mi cesta</a><a href="/cuenta">Mi cuenta</a><a href="/admin">Panel omnicanal</a><a href="/admin/documentacion/guia-demo">Guía de la demostración</a><a href="/feeds/products.xml">Feed de productos</a></div><div class="footer-note"><span class="eyebrow">CONECTADO POR LOGIC2B</span><p>Una tienda, todos tus canales.</p><small>Demo comercial con catálogo público y referencias ficticias. Proveedor y marketplaces simulados. No se realizan ventas ni envíos reales.</small></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} FarmaHouse Demo · Una experiencia Logic2B</span><span>Catálogo público y de ejemplo · Operaciones demo</span></div></footer>
<div id="cart-toast" class="cart-toast" hidden><Icon name="check" size={20}/><span role="status" aria-live="polite" id="cart-toast-message"></span><a href="/carrito">Ver cesta →</a><button type="button" id="cart-toast-close" aria-label="Cerrar aviso">×</button></div>
<script>
import {addToCart,bindCartBadge} from '../lib/cart-client';
const badge = document.getElementById('cart-count');
if(badge) bindCartBadge(badge);
let toastTimer: ReturnType<typeof setTimeout>;
let lastAddedButton: HTMLButtonElement | null = null;
const toast=document.getElementById('cart-toast')!;
function hideToast(){toast.hidden=true;toast.classList.remove('visible');}
function scheduleHide(){clearTimeout(toastTimer);toastTimer=setTimeout(()=>{if(!toast.matches(':hover')&&!toast.contains(document.activeElement))hideToast();},6000);}
toast.addEventListener('pointerenter',()=>clearTimeout(toastTimer));
toast.addEventListener('focusin',()=>clearTimeout(toastTimer));
toast.addEventListener('pointerleave',scheduleHide);
toast.addEventListener('focusout',scheduleHide);
document.getElementById('cart-toast-close')?.addEventListener('click',()=>{hideToast();if(lastAddedButton?.isConnected)lastAddedButton.focus({preventScroll:true});});
document.addEventListener('click',event=>{
  const target = (event.target as Element).closest<HTMLButtonElement>('[data-add-cart]');
  if(!target || target.disabled) return;
  const slug = target.dataset.addCart;
  if(!slug) return;
  lastAddedButton=target;
  const quantityInput = document.querySelector<HTMLInputElement>('[data-product-quantity]');
  if(target.hasAttribute('data-use-quantity') && quantityInput && !quantityInput.reportValidity()) return;
  const qty = target.hasAttribute('data-use-quantity') && quantityInput ? Math.floor(Number(quantityInput.value)) : 1;
  try {
    const added=addToCart(slug,qty,Number(target.dataset.stock)||99);
    toast.hidden=false;toast.classList.add('visible');
    document.getElementById('cart-toast-message')!.textContent=added>0 ? `${target.dataset.productName || 'Producto'} añadido a tu cesta${added>1 ? ` · ${added} unidades` : ''}.` : 'Ya tienes en la cesta todas las unidades disponibles de este producto.';
    scheduleHide();
  }catch {
    toast.hidden=false;toast.classList.add('visible');
    document.getElementById('cart-toast-message')!.textContent='No hemos podido guardar la cesta. Permite el almacenamiento local en tu navegador y vuelve a intentarlo.';
  }
});
</script>
</body></html>
