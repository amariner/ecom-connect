---
import '../styles/brand.css';
import '../styles/admin.css';
import '../styles/ecosystem.css';
import '../styles/admin-refinements.css';
import FarmaHouseLogo from '../components/FarmaHouseLogo.astro';
interface Props { title: string; section: string }
const { title, section } = Astro.props;
const nav = [
  { id: 'dashboard', label: 'Vista general', href: '/admin', icon: '▦' },
  { id: 'products', label: 'Productos', href: '/admin/productos', icon: '◇' },
  { id: 'orders', label: 'Pedidos', href: '/admin/pedidos', icon: '▤' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><meta name="theme-color" content="#84ba47" />
    <title>{title} · FarmaHouse</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#admin-main">Saltar al contenido</a>
    <aside class="admin-sidebar" id="admin-sidebar">
      <button class="mobile-nav-close" type="button" aria-label="Cerrar menú">×</button>
      <a class="admin-brand" href="/admin" aria-label="FarmaHouse, inicio del panel"><FarmaHouseLogo /><small>PANEL DE GESTIÓN</small></a>
      <p class="nav-section-label">TU NEGOCIO</p>
      <nav aria-label="Navegación principal">
        {nav.map(item => <a href={item.href} class:list={['nav-item', { active: section === item.id }]} aria-current={section === item.id ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">{item.icon}</span>{item.label}{section === item.id && <span class="nav-active-dot" />}</a>)}
        <p class="nav-section-label integration-label">INTEGRACIONES</p>
        <a href="/admin/integraciones/proveedor" class:list={['nav-item', { active: section === 'supplier' }]} aria-current={section === 'supplier' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">⇄</span>Proveedor<span class="connection-dot" /></a>
        <a href="/admin/integraciones/lighthouse" class:list={['nav-item', { active: section === 'lighthouse' || section === 'marketplaces' }]} aria-current={section === 'lighthouse' ? 'page' : section === 'marketplaces' ? 'location' : undefined}><span class="nav-icon" aria-hidden="true">⌁</span>Marketplaces<span class="connection-dot" /></a>
      </nav>
      <div class="sidebar-bottom">
        <a href="/admin/configuracion" class:list={['nav-item', { active: section === 'settings' }]} aria-current={section === 'settings' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">⚙</span>Configuración</a>
        <a href="/admin/documentacion" class:list={['sidebar-docs-button', { active: section === 'documentation' }]} aria-current={section === 'documentation' ? 'page' : undefined}><span class="nav-icon" aria-hidden="true">≡</span><span>Guía y documentación</span><span class="sidebar-docs-arrow" aria-hidden="true">↗</span></a>
        <div class="sidebar-user"><span class="user-avatar" aria-hidden="true">FH</span><span>Administrador demo<small>Equipo FarmaHouse</small></span></div>
      </div>
    </aside>
    <button class="admin-sidebar-backdrop" type="button" aria-label="Cerrar menú" tabindex="-1" hidden></button>
    <div class="admin-workspace">
      <header class="admin-topbar"><div class="breadcrumb"><button class="mobile-nav-button" aria-label="Abrir menú" aria-expanded="false" aria-controls="admin-sidebar">☰</button><span>FarmaHouse</span><span class="breadcrumb-divider">/</span><strong>{title}</strong></div><div class="topbar-actions"><span class="demo-label"><span />DEMO INTERACTIVA</span><a class="view-store-link" href="/">Ver tienda <span aria-hidden="true">↗</span></a><span class="topbar-avatar" aria-hidden="true">FH</span></div></header>
      <main id="admin-main" class="admin-main" tabindex="-1"><slot /></main>
      <footer class="admin-footer"><span>FarmaHouse <span class="footer-dot">·</span> La operación, en un solo lugar.</span><span>Una demo de <strong>Logic2B</strong><span class="footer-dot">↗</span></span></footer>
    </div>
    <div id="admin-notice" class="admin-notice" role="status" aria-live="polite" hidden></div>
    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.mobile-nav-button')!;
      const sidebar = document.querySelector<HTMLElement>('#admin-sidebar')!;
      const closeButton = document.querySelector<HTMLButtonElement>('.mobile-nav-close')!;
      const backdrop = document.querySelector<HTMLButtonElement>('.admin-sidebar-backdrop')!;
      const workspace = document.querySelector<HTMLElement>('.admin-workspace')!;
      const mobile = window.matchMedia('(max-width: 680px)');
      let previousMobile = mobile.matches;
      let mobileControlFocused = false;
      function setMenu(open: boolean, restoreFocus = true) {
        const expanded = mobile.matches && open;
        document.body.classList.toggle('sidebar-open', expanded);
        menuButton.setAttribute('aria-expanded', String(expanded));
        menuButton.setAttribute('aria-label', expanded ? 'Cerrar menú' : 'Abrir menú');
        sidebar.inert = mobile.matches && !expanded;
        workspace.inert = expanded;
        backdrop.hidden = !expanded;
        if (expanded) requestAnimationFrame(() => { if (document.body.classList.contains('sidebar-open')) closeButton.focus(); });
        else if (restoreFocus && mobile.matches) menuButton.focus();
      }
      menuButton.addEventListener('click', () => setMenu(!document.body.classList.contains('sidebar-open')));
      closeButton.addEventListener('click', () => setMenu(false));
      backdrop.addEventListener('click', () => setMenu(false));
      sidebar.addEventListener('click', event => {
        if ((event.target as Element).closest('a') && mobile.matches) setMenu(false, false);
      });
      document.addEventListener('keydown', event => {
        if (!document.body.classList.contains('sidebar-open')) return;
        if (event.key === 'Escape') { event.preventDefault(); setMenu(false); }
        if (event.key === 'Tab') {
          const links = [...sidebar.querySelectorAll<HTMLElement>('a, button')];
          const first = links[0];
          const last = links[links.length - 1];
          if (!sidebar.contains(document.activeElement)) { event.preventDefault(); first?.focus(); }
          else if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
        }
      });
      // Browsers can drop focus from a disappearing mobile control before the media change
      // event, with or without a focusout. Only a blur on the mobile layout is deliberate.
      document.addEventListener('focusin', event => {
        mobileControlFocused = event.target === menuButton || event.target === closeButton;
      });
      document.addEventListener('focusout', event => {
        if (!(previousMobile && !mobile.matches && !event.relatedTarget)) mobileControlFocused = false;
      });
      mobile.addEventListener('change', () => {
        const focused = document.activeElement;
        const sidebarHadFocus = sidebar.contains(focused);
        const lostFocus = focused === document.body;
        const openMenuLostFocus = lostFocus && document.body.classList.contains('sidebar-open');
        const mobileControlHadFocus = focused === closeButton || focused === menuButton
          || (lostFocus && mobileControlFocused);
        mobileControlFocused = false;
        setMenu(false, false);
        if (mobile.matches && sidebarHadFocus) menuButton.focus();
        else if (!mobile.matches && (mobileControlHadFocus || openMenuLostFocus)) {
          const visibleLink = sidebar.querySelector<HTMLAnchorElement>('a[aria-current="page"]')
            ?? sidebar.querySelector<HTMLAnchorElement>('.admin-brand');
          visibleLink?.focus();
        }
        previousMobile = mobile.matches;
      });
      setMenu(false, false);
    </script>
  </body>
</html>
