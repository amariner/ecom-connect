---
import Icon from './Icon.astro';
const scenes=[
 {id:'facial',image:'facial',alt:'Un momento de calma y cuidado facial con luz natural.',eyebrow:'TU RUTINA, TU MOMENTO',title:'Cuidarte empieza',emphasis:'por ti.',text:'Descubre tu próxima rutina facial. Limpieza, hidratación y pequeños gestos que marcan la diferencia.',link:'Encuentra tu cuidado facial',note:'Una selección para cada piel',label:'Cuidado facial'},
 {id:'bebe',image:'baby',alt:'Una madre y su bebé comparten una sonrisa en casa.',eyebrow:'PARA SUS PRIMEROS GRANDES PASOS',title:'Pequeños cuidados.',emphasis:'Mucho amor.',text:'Todo un mundo para acompañaros: baño, alimentación y los esenciales de cada día.',link:'Explorar bebé e infantil',note:'Contigo desde el primer día',label:'Bebé e infantil'},
 {id:'bucodental',image:'smile',alt:'Una sonrisa espontánea en una terraza luminosa.',eyebrow:'BIENESTAR EN CADA SONRISA',title:'Tu sonrisa,',emphasis:'cada día.',text:'Cepillos, dentífricos y cuidado bucal. Encuentra los esenciales que encajan con tu rutina.',link:'Descubrir cuidado bucal',note:'Lo cotidiano también importa',label:'Salud bucodental'},
];

---
<section class="discovery-hero wrap" aria-roledescription="carrusel" aria-label="Selecciones de FarmaHouse" data-home-hero>
 <h1 class="sr-only">Tu bienestar empieza en FarmaHouse</h1>
 <div class="discovery-hero-slides">{scenes.map((scene,index)=><div class:list={['discovery-slide',`discovery-slide-${scene.id}`]} role="group" aria-roledescription="diapositiva" aria-label={`${index+1} de ${scenes.length}: ${scene.label}`} hidden={index!==0} data-hero-slide>
  <div class="discovery-hero-copy"><span class="discovery-kicker"><i></i>{scene.eyebrow}</span><h2>{scene.title}<br/><em>{scene.emphasis}</em></h2><p>{scene.text}</p><a class="button button-dark" href={`/tienda?categoria=${scene.id}`}>{scene.link}<Icon name="arrow" size={19}/></a><span class="discovery-proof"><Icon name="leaf" size={18}/>{scene.note}</span></div>
  <div class="discovery-hero-art">
   <img class="hero-campaign-image" src={`/images/heroes/hero-campaign-${scene.image}.webp`} srcset={`/images/heroes/hero-campaign-${scene.image}-small.webp 700w, /images/heroes/hero-campaign-${scene.image}.webp 1400w`} sizes="(max-width: 780px) 100vw, 58vw" alt={scene.alt} width="1400" height="933" loading={index===0?'eager':'lazy'} fetchpriority={index===0?'high':'auto'} decoding="async"/>
   <span class="hero-campaign-signature"><span aria-hidden="true">✳</span> Momentos FarmaHouse</span>
  </div>
 </div>)}</div>
 <div class="discovery-hero-bottom"><div class="hero-slide-selectors" aria-label="Elegir selección">{scenes.map((scene,index)=><button type="button" data-hero-go={index} aria-pressed={index===0} aria-label={`Mostrar ${scene.label}`}><small>0{index+1}</small><span>{scene.label}</span><i aria-hidden="true"/></button>)}</div><div class="hero-playback"><span data-hero-counter>01 / 03</span><button type="button" data-hero-prev aria-label="Selección anterior">←</button><button type="button" data-hero-next aria-label="Selección siguiente">→</button><button type="button" data-hero-pause aria-label="Pausar carrusel" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button></div></div>
 <span class="sr-only" data-hero-announcement aria-live="polite" aria-atomic="true"/>
</section>
<script>
import {initHomeHero} from './home-hero';
const root=document.querySelector<HTMLElement>('[data-home-hero]');
if(root)initHomeHero(root);
</script>
