---
import Shop from '../layouts/Shop.astro';
import HomeHero from '../components/shop/HomeHero.astro';
import '../styles/home-hero.css';
import '../styles/home-products.css';
import Icon from '../components/shop/Icon.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import {categories, homeCategories} from '../components/shop/catalog';
import {getPublicProducts} from '../lib/catalog-cache';
const products = await getPublicProducts(Astro.locals.runtime.env.DB);
const publicProducts = products.filter(p=>p.source_url && p.active);
const selection = publicProducts.length ? publicProducts : products;
const available = selection.filter(product => product.active && product.stock > 0);
const selectedIds = new Set<number>();
const collections = [
  {id:'rutina',eyebrow:'UN MOMENTO PARA TI',title:'Tu rutina de cada día',description:'Facial, cabello y sonrisa: encuentra tu próximo esencial.',categories:['facial','dermocosmetica','capilar','bucodental']},
  {id:'familia',eyebrow:'PEQUEÑOS GESTOS, CADA DÍA',title:'Cuidado para toda la familia',description:'Una selección para acompañar cada etapa.',categories:['bebe','maternidad','higiene','bienestar']},
  {id:'bienestar',eyebrow:'SIGUE EXPLORANDO',title:'Bienestar que te acompaña',description:'Descubre otras formas de completar tu cuidado.',categories:['nutricion','solares','ortopedia','veterinaria']},
].map(collection => {
  const selectedBrands = new Set<string>();
  const collectionProducts = collection.categories.flatMap(category => {
    const candidates = available.filter(product => product.category === category && !selectedIds.has(product.id));
    const product = candidates.find(candidate => !selectedBrands.has(candidate.brand)) ?? candidates[0];
    if (!product) return [];
    selectedIds.add(product.id);
    selectedBrands.add(product.brand);
    return [product];
  });
  return {...collection,products:collectionProducts,categories:categories.filter(category=>collectionProducts.some(product=>product.category===category.id))};
}).filter(collection => collection.products.length > 0);
const brands = [...new Set(selection.map(p=>p.brand))].slice(0,6);
---
<Shop title="Tu bienestar empieza en lo cotidiano">
<HomeHero />
<div class="benefits-strip wrap"><div><Icon name="truck" size={23}/><span><strong>Envío gratis desde 49 €</strong><small>Condiciones de envío simuladas</small></span></div><div><Icon name="shield" size={23}/><span><strong>Cuidado en cada elección</strong><small>Una selección para tu día a día</small></span></div><div><Icon name="leaf" size={23}/><span><strong>Marcas por descubrir</strong><small>Un universo de bienestar</small></span></div><div><Icon name="bag" size={23}/><span><strong>Compra en modo demo</strong><small>Explora sin pagos reales</small></span></div></div>
<section class="section wrap category-section"><div class="section-heading"><div><span class="eyebrow">UN CUIDADO PARA CADA MOMENTO</span><h2>¿Por dónde empezamos?</h2></div><a class="text-link" href="/tienda">Ver todo <Icon name="arrow" size={18}/></a></div><div class="category-grid">{homeCategories.map(category=><a class="category-card" href={`/tienda?categoria=${category.id}`}><span class="category-icon" style={`--category-color:${category.color}`}><Icon name={category.icon} size={32}/></span><span>{category.short}</span></a>)}</div></section>
{collections.slice(0,2).map(collection=><section class="section wrap home-product-collection" aria-labelledby={`home-${collection.id}`}>
  <div class="section-heading"><div><span class="eyebrow">{collection.eyebrow}</span><h2 id={`home-${collection.id}`}>{collection.title}</h2><p>{collection.description}</p></div><a class="text-link" href="/tienda">Ver catálogo <Icon name="arrow" size={18}/></a></div>
  <nav class="home-collection-categories" aria-label={`Categorías de ${collection.title.toLowerCase()}`}>{collection.categories.map(category=><a href={`/tienda?categoria=${category.id}`}>{category.short}<Icon name="arrow" size={14}/></a>)}</nav>
  <div class="product-grid home-product-grid">{collection.products.map((product,index)=><ProductCard product={product} index={index}/>)}</div>
  <span class="home-product-scroll-hint" aria-hidden="true">Desliza para descubrir la selección <Icon name="arrow" size={14}/></span>
</section>)}
<section class="wrap promo-grid"><a class="promo-card promo-skin" href="/tienda?categoria=facial"><div><span class="eyebrow">TU PIEL, A TU RITMO</span><h2>Un momento<br/>solo para ti.</h2><p>Haz espacio para tu rutina facial.</p><span class="text-link">Descubrir cuidado facial <Icon name="arrow" size={20}/></span></div><img class="promo-photo" src="/images/heroes/hero-facial.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async"/></a><a class="promo-card promo-sun" href="/tienda?categoria=solares"><div><span class="eyebrow">TODOS LOS DÍAS, TODO EL AÑO</span><h2>Disfruta del sol.<br/><em>Cuida tu piel.</em></h2><p>Tu próximo esencial va contigo.</p><span class="text-link">Explorar solares <Icon name="arrow" size={20}/></span></div><img class="promo-photo" src="/images/heroes/hero-sun.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async"/></a></section>
{collections.slice(2).map(collection=><section class="section wrap home-product-collection" aria-labelledby={`home-${collection.id}`}>
  <div class="section-heading"><div><span class="eyebrow">{collection.eyebrow}</span><h2 id={`home-${collection.id}`}>{collection.title}</h2><p>{collection.description}</p></div><a class="text-link" href="/tienda">Ver catálogo <Icon name="arrow" size={18}/></a></div>
  <nav class="home-collection-categories" aria-label={`Categorías de ${collection.title.toLowerCase()}`}>{collection.categories.map(category=><a href={`/tienda?categoria=${category.id}`}>{category.short}<Icon name="arrow" size={14}/></a>)}</nav>
  <div class="product-grid home-product-grid">{collection.products.map((product,index)=><ProductCard product={product} index={index}/>)}</div>
  <span class="home-product-scroll-hint" aria-hidden="true">Desliza para descubrir la selección <Icon name="arrow" size={14}/></span>
</section>)}
<section class="section wrap brands-section"><span class="eyebrow">MARCAS PARA CADA MOMENTO DE CUIDADO.</span><div class="brands-row">{brands.map(brand=><a href={`/tienda?marca=${encodeURIComponent(brand)}`}>{brand}</a>)}</div></section>
<section class="omnichannel-callout"><div class="wrap"><span class="eyebrow">MÁS ALLÁ DE LA TIENDA</span><h2>Todo tu comercio.<br/><em>En perfecta conexión.</em></h2><p>Descubre cómo el catálogo, los pedidos web y los marketplaces<br class="desktop-break"/> se conectan con el proveedor en una sola experiencia.</p><a class="button button-light" href="/admin">Explorar la demo omnicanal <Icon name="arrow" size={20}/></a><div class="connection-steps"><span>Proveedor Demo</span><span aria-hidden="true">↔</span><strong>Logic2B</strong><span aria-hidden="true">↔</span><span>Lighthouse Feed</span><span aria-hidden="true">↔</span><span>Marketplaces</span></div></div></section>
</Shop>
