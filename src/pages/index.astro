---
import Shop from '../layouts/Shop.astro';
import Icon from '../components/shop/Icon.astro';
import ProductCard from '../components/shop/ProductCard.astro';
import {categories} from '../components/shop/catalog';
import {getProducts} from '../lib/demo';
const products = await getProducts(Astro.locals.runtime.env.DB);
const featured = products.filter(p=>p.active && p.stock>0).filter((_,i)=>[0,5,10,15].includes(i)).slice(0,4);
const brands = [...new Set(products.map(p=>p.brand))].slice(0,6);
---
<Shop title="Tu bienestar empieza en lo cotidiano">
<section class="home-hero wrap"><div class="hero-copy"><div class="hero-kicker"><span></span> TU ESPACIO DE CUIDADO DIARIO</div><h1>Cuidarte está<br/>en tu <em>naturaleza.</em></h1><p>Lo que necesitas para sentirte bien,<br class="desktop-break"/> seleccionado con todo el cuidado.</p><a class="button button-dark" href="/tienda">Descubre tus esenciales <Icon name="arrow" size={20}/></a><div class="hero-proof"><span class="proof-icon"><Icon name="leaf" size={17}/></span><span>Cuidado consciente, de la cabeza a los pies.</span></div></div><div class="hero-art"><div class="hero-art-circle"></div><img src="/images/hero-products.svg" alt="Selección de cosmética y cuidado diario ficticios de FarmaHouse" width="760" height="640" fetchpriority="high"/><span class="hero-floating-label"><Icon name="sparkle" size={20}/><span>Tu rutina.<br/><strong>Tu momento.</strong></span></span><span class="hero-image-caption">ESENCIALES PARA TODOS LOS DÍAS</span></div><div class="hero-bottom-note"><span>01 / El arte de cuidarte</span><span>BIENESTAR QUE TE ACOMPAÑA <span aria-hidden="true">↗</span></span></div></section>
<div class="benefits-strip wrap"><div><Icon name="truck" size={23}/><span><strong>Envío gratis desde 49 €</strong><small>Condiciones de envío simuladas</small></span></div><div><Icon name="shield" size={23}/><span><strong>Cuidado en cada elección</strong><small>Una selección para tu día a día</small></span></div><div><Icon name="leaf" size={23}/><span><strong>Marcas por descubrir</strong><small>Un universo de bienestar</small></span></div><div><Icon name="bag" size={23}/><span><strong>Compra en modo demo</strong><small>Explora sin pagos reales</small></span></div></div>
<section class="section wrap category-section"><div class="section-heading"><div><span class="eyebrow">UN CUIDADO PARA CADA MOMENTO</span><h2>¿Por dónde empezamos?</h2></div><a class="text-link" href="/tienda">Ver todo <Icon name="arrow" size={18}/></a></div><div class="category-grid">{categories.map(category=><a class="category-card" href={`/tienda?categoria=${category.id}`}><span class="category-icon" style={`--category-color:${category.color}`}><Icon name={category.icon} size={32}/></span><span>{category.short}</span></a>)}</div></section>
<section class="section wrap favorites-section"><div class="section-heading"><div><span class="eyebrow">LOS PEQUEÑOS IMPRESCINDIBLES</span><h2>Favoritos para tu rutina</h2></div><a class="text-link" href="/tienda?orden=destacados">Encuentra los tuyos <Icon name="arrow" size={18}/></a></div><div class="product-grid">{featured.map((product,index)=><ProductCard product={product} index={index}/>)}</div></section>
<section class="wrap promo-grid"><a class="promo-card promo-skin" href="/tienda?categoria=facial"><div><span class="eyebrow">TU PIEL, A TU RITMO</span><h2>Un momento<br/>solo para ti.</h2><p>Haz espacio para tu rutina facial.</p><span class="text-link">Descubrir cuidado facial <Icon name="arrow" size={20}/></span></div><div class="promo-orbit"><Icon name="drop" size={100}/></div></a><a class="promo-card promo-sun" href="/tienda?categoria=solares"><div><span class="eyebrow">TODOS LOS DÍAS, TODO EL AÑO</span><h2>Disfruta del sol.<br/><em>Cuida tu piel.</em></h2><p>Tu próximo esencial va contigo.</p><span class="text-link">Explorar solares <Icon name="arrow" size={20}/></span></div><div class="promo-sun-art"><Icon name="sun" size={130}/></div></a></section>
<section class="section wrap brands-section"><span class="eyebrow">MARCAS FICTICIAS. UNA EXPERIENCIA REAL.</span><div class="brands-row">{brands.map(brand=><a href={`/tienda?marca=${encodeURIComponent(brand)}`}>{brand}</a>)}</div></section>
<section class="omnichannel-callout"><div class="wrap"><span class="eyebrow">MÁS ALLÁ DE LA TIENDA</span><h2>Todo tu comercio.<br/><em>En perfecta conexión.</em></h2><p>Descubre cómo el catálogo, los pedidos web y los marketplaces<br class="desktop-break"/> se conectan con el proveedor en una sola experiencia.</p><a class="button button-light" href="/admin">Explorar la demo omnicanal <Icon name="arrow" size={20}/></a><div class="connection-steps"><span>Proveedor Demo</span><span aria-hidden="true">↔</span><strong>Logic2B</strong><span aria-hidden="true">↔</span><span>Lighthouse Feed</span><span aria-hidden="true">↔</span><span>Marketplaces</span></div></div></section>
</Shop>
