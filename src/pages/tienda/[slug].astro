---
import Shop from '../../layouts/Shop.astro';
import Icon from '../../components/shop/Icon.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import {categoryName,euros} from '../../components/shop/catalog';
import {getProduct,getProducts} from '../../lib/demo';
const product=await getProduct(Astro.locals.runtime.env.DB,Astro.params.slug!);
if(!product||!product.active) return Astro.redirect('/404');
const related=(await getProducts(Astro.locals.runtime.env.DB)).filter(p=>p.active&&p.category===product.category&&p.slug!==product.slug).slice(0,4);
const discount=(product.compare_at_price_cents??0)>product.price_cents?Math.round((1-product.price_cents/(product.compare_at_price_cents??product.price_cents))*100):0;
---
<Shop title={product.name} description={product.description}>
<div class="wrap"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/tienda">Tienda</a><span>/</span><a href={`/tienda?categoria=${product.category}`}>{categoryName(product.category)}</a></nav><div class="product-detail"><div class="detail-picture"><img src={product.image} alt={product.name} width="680" height="680"/>{discount>0&&<span class="product-tag">−{discount}%</span>}<span class="detail-image-note">PRODUCTO FICTICIO · IMAGEN DE DEMOSTRACIÓN</span></div><div class="detail-copy"><a class="eyebrow" href={`/tienda?marca=${encodeURIComponent(product.brand)}`}>{product.brand}</a><h1>{product.name}</h1><p class="detail-description">{product.description}</p><div class="detail-price"><strong>{euros(product.price_cents)}</strong>{discount>0&&<del>{euros(product.compare_at_price_cents??0)}</del>}{discount>0&&<span>Ahorras {euros((product.compare_at_price_cents??0)-product.price_cents)}</span>}</div><p class="tax-note">IVA incluido · Producto y precio de demostración</p><div class:list={['stock-status',product.stock<=0&&'no-stock']}><span class="status-dot"></span>{product.stock>0?`Disponible · ${product.stock} unidades`:'Temporalmente agotado'}</div><div class="detail-purchase"><label class="quantity-field"><span class="sr-only">Cantidad</span><input data-product-quantity type="number" min="1" max={Math.max(1,Math.min(99,product.stock))} value="1" disabled={product.stock<=0}/></label><button class="button button-dark" data-add-cart={product.slug} data-use-quantity disabled={product.stock<=0}><Icon name="bag" size={20}/>{product.stock>0?'Añadir a mi cesta':'No disponible'}</button></div><div class="detail-promises"><p><Icon name="truck" size={19}/>Envío simulado gratis a partir de 49 €</p><p><Icon name="shield" size={19}/>Compra de demostración, sin cobros reales</p></div><details open><summary>Sobre este producto <Icon name="plus" size={17}/></summary><p>{product.description} Forma parte de nuestro catálogo ficticio de parafarmacia. La información se utiliza exclusivamente para demostrar la experiencia de compra y sincronización.</p></details><details><summary>Información del catálogo <Icon name="plus" size={17}/></summary><dl class="product-specs"><div><dt>Marca</dt><dd>{product.brand}</dd></div><div><dt>Categoría</dt><dd>{categoryName(product.category)}</dd></div><div><dt>Referencia</dt><dd>{product.sku}</dd></div><div><dt>EAN de demo</dt><dd>{product.ean}</dd></div></dl></details><details><summary>Envío y devoluciones de demo <Icon name="plus" size={17}/></summary><p>Este entorno no genera cargos ni envíos reales. Al completar la compra se crea un pedido de prueba que puedes seguir desde el panel omnicanal.</p></details></div></div></div>
{related.length>0&&<section class="wrap section"><div class="section-heading"><div><span class="eyebrow">COMPLETA TU RUTINA</span><h2>Un poco más de cuidado</h2></div><a class="text-link" href={`/tienda?categoria=${product.category}`}>Ver categoría <Icon name="arrow" size={18}/></a></div><div class="product-grid">{related.map((item,index)=><ProductCard product={item} index={index}/>)}</div></section>}
</Shop>
