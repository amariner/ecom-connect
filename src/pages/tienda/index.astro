---
import Shop from '../../layouts/Shop.astro';
import Icon from '../../components/shop/Icon.astro';
import ProductCard from '../../components/shop/ProductCard.astro';
import {categories,categoryName,categoryMatches,subcategories} from '../../components/shop/catalog';
import {queryCatalog,catalogPagePath} from '../../components/shop/catalog-query';
import {getPublicProducts} from '../../lib/catalog-cache';
const all = await getPublicProducts(Astro.locals.runtime.env.DB);
const params = Astro.url.searchParams;
const q=params.get('q')?.trim()??'', category=params.get('categoria')??'', brand=params.get('marca')??'', order=params.get('orden')??'destacados', offers=params.get('ofertas')==='1';
const result=queryCatalog(all,params);
const {products}=result;
const selectedGroup=categories.find(c=>c.id===category||c.children.some(child=>child.id===category));
const pageNumbers=Array.from({length:result.pages},(_,i)=>i+1).filter(n=>n===1||n===result.pages||Math.abs(n-result.page)<=1);
const title=q?`Resultados para “${q}”`:category?categoryName(category):offers?'Pequeños precios, grandes cuidados':'Encuentra tu forma de cuidarte';
const brands=[...new Set(all.map(p=>p.brand))].sort();
const activeFilters = [q && ['q', `Búsqueda: ${q}`], category && ['categoria', categoryName(category)], brand && ['marca', brand], offers && ['ofertas', 'En oferta']].filter((item): item is string[] => Boolean(item));
function withoutFilter(key: string) { const next = new URLSearchParams(params); next.delete(key); next.delete('pagina'); return `/tienda${next.size ? `?${next}` : ''}`; }
---
<Shop title={q?`Buscar ${q}`:category?categoryName(category):'Nuestra tienda'}>
<div class="wrap catalog-intro"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><span>Tienda</span>{category&&<><span>/</span><span>{categoryName(category)}</span></>}</nav><span class="eyebrow">EL CUIDADO EMPIEZA AQUÍ</span><h1>{title}</h1><p>Esenciales de parafarmacia para acompañarte cada día.</p>{selectedGroup&&<nav class="subcategory-chips" aria-label="Subcategorías"><a href={`/tienda?categoria=${selectedGroup.id}`} aria-current={category===selectedGroup.id?'page':undefined}>Todo {selectedGroup.short.toLowerCase()}</a>{selectedGroup.children.map(child=><a href={`/tienda?categoria=${child.id}`} aria-current={category===child.id?'page':undefined}>{child.name}<span> · {all.filter(p=>categoryMatches(p,child.id)).length}</span></a>)}</nav>}</div>
<div class="wrap catalog-layout"><aside class="catalog-sidebar"><details class="catalog-filter-panel" open><summary><span>Filtrar productos{activeFilters.length > 0 && ` · ${activeFilters.length}`}</span><Icon name="plus" size={18}/></summary><form action="/tienda" id="catalog-filters"><div class="filter-title"><h2>Filtrar por</h2>{(q||category||brand||offers)&&<a href="/tienda">Limpiar</a>}</div><label class="filter-label" for="catalog-search">Buscar en el catálogo</label><div class="input-with-icon"><Icon name="search" size={18}/><input type="search" id="catalog-search" name="q" value={q} placeholder="Producto o marca"/></div><fieldset class="category-filters"><legend>Categorías</legend><label><input type="radio" name="categoria" value="" checked={!category}/><span>Todos los productos</span><small>{all.length}</small></label>{subcategories.some(c=>c.id===category)&&<label><input type="radio" name="categoria" value={category} checked/><span>{categoryName(category)}</span><small>{all.filter(p=>categoryMatches(p,category)).length}</small></label>}{categories.map(c=><label><input type="radio" name="categoria" value={c.id} checked={category===c.id}/><span>{c.name}</span><small>{all.filter(p=>categoryMatches(p,c.id)).length}</small></label>)}</fieldset><label class="filter-label" for="brand-filter">Marca</label><select id="brand-filter" name="marca"><option value="">Todas las marcas</option>{brands.map(b=><option value={b} selected={brand===b}>{b}</option>)}</select><label class="checkbox-filter"><input type="checkbox" name="ofertas" value="1" checked={offers}/> Solo productos en oferta</label><input type="hidden" name="orden" value={order}/><button class="button button-dark filter-submit" type="submit">Aplicar filtros <Icon name="arrow" size={17}/></button></form></details><div class="sidebar-demo"><Icon name="leaf" size={27}/><strong>Una selección con sentido</strong><p>Catálogo público de FarmaHouse junto a referencias de ejemplo. Existencias, pagos y envíos de demostración.</p></div></aside><section class="catalog-results" aria-label="Productos"><div class="catalog-toolbar"><span><strong>{result.total}</strong> {result.total===1?'producto':'productos'}{brand&&` · ${brand}`}</span><form action="/tienda" class="sort-form"><input type="hidden" name="q" value={q}/><input type="hidden" name="categoria" value={category}/><input type="hidden" name="marca" value={brand}/>{offers&&<input type="hidden" name="ofertas" value="1"/>}<label for="sort-order">Ordenar por</label><select name="orden" id="sort-order" aria-label="Ordenar productos"><option value="destacados" selected={order==='destacados'}>Destacados</option><option value="precio-asc" selected={order==='precio-asc'}>Precio: menor a mayor</option><option value="precio-desc" selected={order==='precio-desc'}>Precio: mayor a menor</option><option value="nombre" selected={order==='nombre'}>Nombre A–Z</option></select><button class="button button-outline sort-submit" type="submit">Ordenar</button></form></div>{activeFilters.length > 0 && <nav class="active-filters" aria-label="Filtros aplicados">{activeFilters.map(([key,label]) => <a href={withoutFilter(key!)} aria-label={`Quitar filtro ${label}`}>{label}<span aria-hidden="true">×</span></a>)}<a class="clear-filters" href="/tienda">Limpiar todo</a></nav>}{products.length?<><div class="product-grid catalog-product-grid">{products.map((product,index)=><ProductCard product={product} index={index}/>)}</div><p class="catalog-page-note">Mostrando {result.start}–{result.end} de {result.total} productos</p>{result.pages>1&&<nav class="catalog-pagination" aria-label="Páginas del catálogo">{result.page>1&&<a href={catalogPagePath(params,result.page-1)} rel="prev" aria-label="Página anterior">←</a>}{pageNumbers.map((n,i)=><>{i>0&&n>(pageNumbers[i-1]??0)+1&&<span aria-hidden="true">…</span>}<a href={catalogPagePath(params,n)} aria-current={n===result.page?'page':undefined} aria-label={`Página ${n}`}>{n}</a></>)}{(result.page < result.pages)&&<a href={catalogPagePath(params,result.page+1)} rel="next" aria-label="Página siguiente">→</a>}</nav>}</>:<div class="empty-state"><Icon name="search" size={42}/><h2>No hemos encontrado productos</h2><p>Prueba con otra búsqueda o elimina algún filtro.</p><a class="button button-dark" href="/tienda">Ver todo el catálogo</a></div>}</section></div>
<script>
import {bindFilterPanel} from '../../components/shop/filter-panel';
const panel=document.querySelector<HTMLDetailsElement>('.catalog-filter-panel');
if(panel) bindFilterPanel(panel,window.matchMedia('(max-width:580px)'),document);
</script>
</Shop>
