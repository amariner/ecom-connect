---
import Shop from '../layouts/Shop.astro';
import Icon from '../components/shop/Icon.astro';
import CheckoutSteps from '../components/shop/CheckoutSteps.astro';
---
<Shop title="Tu cesta"><div class="wrap"><CheckoutSteps step={1}/><div class="page-heading"><span class="eyebrow">UN POCO DE CUIDADO PARA TI</span><h1>Tu cesta</h1><p>Tus próximos esenciales empiezan aquí.</p></div><div id="cart-error" class="form-error" role="alert" hidden></div><button class="button button-outline" id="cart-retry" type="button" hidden>Volver a consultar la cesta</button><p id="cart-update-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p><div id="cart-loading" class="loading-state" role="status">Consultando precios y disponibilidad…</div><div id="cart-empty" class="empty-state" hidden><Icon name="bag" size={44}/><h2>Tu cesta está esperando un poco de cuidado</h2><p>Explora nuestro catálogo y encuentra esos pequeños imprescindibles para tu día a día.</p><a class="button button-dark" href="/tienda">Descubre tus esenciales <Icon name="arrow" size={18}/></a></div><div id="cart-content" class="commerce-layout" hidden><section aria-label="Productos de tu cesta"><div id="cart-lines" class="cart-lines"></div><a class="text-link continue-shopping" href="/tienda">← Seguir descubriendo</a></section><aside class="order-summary"><h2>Tu resumen</h2><div class="summary-row"><span>Subtotal</span><strong id="cart-subtotal"></strong></div><div class="summary-row"><span>Envío estimado · Península</span><strong id="cart-shipping"></strong></div><div class="summary-row summary-total"><span>Total estimado</span><strong id="cart-total"></strong></div><p class="tax-note">IVA incluido</p><div id="shipping-progress" class="shipping-progress"></div><a id="checkout-link" class="button button-dark" href="/checkout">Continuar con la demo <Icon name="arrow" size={18}/></a><p class="summary-footnote">Compra simulada. No se realizará ningún cobro.<br/>El envío se confirma con el código postal.</p></aside></div><noscript><div class="demo-notice">Activa JavaScript para usar la cesta y completar una compra simulada.</div></noscript></div>
<script>
import {readCart,setQty,removeFromCart} from '../lib/cart-client';
import {euros} from '../components/shop/catalog';
import {requestQuote,type CartQuote,escapeHtml} from '../components/shop/commerce-client';

type CartFocus = { slug?: string | undefined; control: 'quantity' | 'remove' };
let requestId=0;
let nextFocus:CartFocus|null=null;
const loading=document.getElementById('cart-loading')!;
const error=document.getElementById('cart-error')!;
const retry=document.getElementById('cart-retry')!;
const content=document.getElementById('cart-content')!;
const empty=document.getElementById('cart-empty')!;
const linesElement=document.getElementById('cart-lines')!;
const status=document.getElementById('cart-update-status')!;

function showError(message:string){error.textContent=message;error.hidden=false;}
function restoreFocus(target:CartFocus|null){
 if(!target)return;
 const control=target.slug
   ? linesElement.querySelector<HTMLElement>(`[data-${target.control}="${CSS.escape(target.slug)}"]`)
   : empty.querySelector<HTMLAnchorElement>('a');
 control?.focus({preventScroll:true});
}
async function renderCart(){
 const id=++requestId;
 const focused=document.activeElement as HTMLElement|null;
 const retrying=focused===retry;
 error.hidden=true;retry.hidden=true;content.setAttribute('aria-busy','true');
 const inferredFocus:CartFocus|null=focused?.dataset.quantity
   ? {slug:focused.dataset.quantity,control:'quantity'}
   : focused?.dataset.remove ? {slug:focused.dataset.remove,control:'remove'} : null;
 const focusTarget=nextFocus??inferredFocus;nextFocus=null;
 const lines=readCart();
 if(!lines.length){
  loading.hidden=true;content.hidden=true;content.removeAttribute('aria-busy');empty.hidden=false;
  if(focusTarget){status.textContent='Tu cesta está vacía. Puedes seguir explorando la tienda.';restoreFocus({control:'remove'});}
  return;
 }
 empty.hidden=true;loading.hidden=false;
 try {
  const quote:CartQuote=await requestQuote(lines,'28001');
  if(id!==requestId)return;
  const keepFocus=Boolean(focusTarget && (document.activeElement===focused || (retrying && document.activeElement===document.body)));
  linesElement.innerHTML=quote.lines.map(line=>`<article class="cart-line"><a href="/tienda/${encodeURIComponent(line.slug)}"><img class="cart-line-img" src="${escapeHtml(line.image||'/images/hero-products.svg')}" alt="${escapeHtml(line.name)}" width="95" height="105"/></a><div><p class="cart-line-brand">Tu cuidado diario</p><h2><a href="/tienda/${encodeURIComponent(line.slug)}">${escapeHtml(line.name)}</a></h2><p class="cart-line-price">${euros(line.unit_price_cents)}</p><div class="cart-line-actions"><label><span class="sr-only">Cantidad de ${escapeHtml(line.name)}</span><input data-quantity="${escapeHtml(line.slug)}" type="number" min="1" max="99" value="${line.qty}"/></label><button class="remove-line" data-remove="${escapeHtml(line.slug)}" aria-label="Eliminar ${escapeHtml(line.name)} de la cesta" type="button">Eliminar</button></div>${line.status!=='ok'?`<p class="line-error">${line.status==='not-found'?'Este producto ya no está disponible. Elimínalo para continuar.':line.status==='out-of-stock'?'Este producto se ha agotado. Elimínalo para continuar.':`Solo quedan ${line.available_stock} unidades. Ajusta la cantidad.`}</p>`:''}</div><strong class="cart-line-total">${euros(line.line_total_cents)}</strong></article>`).join('');
  document.getElementById('cart-subtotal')!.textContent=euros(quote.subtotal_cents);
  document.getElementById('cart-shipping')!.textContent=quote.shipping_cents===0?'Gratis':quote.shipping_cents===null?'Por calcular':euros(quote.shipping_cents);
  document.getElementById('cart-total')!.textContent=quote.total_cents===null?'Por calcular':euros(quote.total_cents);
  const threshold=quote.shipping?.free_over_cents??4900;
  document.getElementById('shipping-progress')!.innerHTML=quote.subtotal_cents>=threshold?'Tu cesta ya tiene envío simulado gratis.':`Te faltan <strong>${euros(threshold-quote.subtotal_cents)}</strong> para el envío gratis.<progress value="${quote.subtotal_cents}" max="${threshold}" aria-label="Progreso para conseguir envío gratuito"></progress>`;
  const link=document.getElementById('checkout-link') as HTMLAnchorElement;
  link.setAttribute('aria-disabled',String(!quote.purchasable));link.style.opacity=quote.purchasable?'1':'.45';link.href=quote.purchasable?'/checkout':'#cart-lines';
  content.hidden=false;
  if(keepFocus)restoreFocus(focusTarget);
  if(focusTarget){
   const count=quote.lines.reduce((total,line)=>total+line.qty,0);
   status.textContent=`Cesta actualizada: ${count} ${count===1?'unidad':'unidades'}. ${quote.purchasable ? `Total estimado ${euros(quote.total_cents??quote.subtotal_cents)}.` : 'Revisa la disponibilidad de los productos antes de continuar.'}`;
  }
 }catch(e){
  if(id!==requestId)return;
  const moveFocus=Boolean(focusTarget && (document.activeElement===focused || (retrying && document.activeElement===document.body)));
  content.hidden=true;
  showError(e instanceof Error?e.message:'No hemos podido consultar la cesta.');retry.hidden=false;
  if(moveFocus)retry.focus({preventScroll:true});
 }finally{if(id===requestId){loading.hidden=true;content.removeAttribute('aria-busy');}}
}
retry.addEventListener('click',()=>{nextFocus={slug:readCart()[0]?.slug,control:'quantity'};void renderCart();});
linesElement.addEventListener('change',event=>{
 const input=(event.target as Element).closest<HTMLInputElement>('[data-quantity]');if(!input)return;
 const qty=Math.max(1,Math.min(99,Math.floor(Number(input.value)||1)));
 try{setQty(input.dataset.quantity!,qty);}
 catch{input.value=String(readCart().find(line=>line.slug===input.dataset.quantity)?.qty??1);showError('No hemos podido guardar el cambio. Permite el almacenamiento local del navegador y vuelve a intentarlo.');}
});
linesElement.addEventListener('click',event=>{
 const button=(event.target as Element).closest<HTMLButtonElement>('[data-remove]');if(!button)return;
 const lines=readCart(),index=lines.findIndex(line=>line.slug===button.dataset.remove);
 nextFocus={slug:(lines[index+1]??lines[index-1])?.slug,control:'remove'};
 try{removeFromCart(button.dataset.remove!);}
 catch{nextFocus=null;showError('No hemos podido eliminar el producto. Permite el almacenamiento local del navegador y vuelve a intentarlo.');}
});
document.addEventListener('cart:changed',()=>void renderCart());
window.addEventListener('storage',()=>void renderCart());
void renderCart();
</script>
</Shop>
